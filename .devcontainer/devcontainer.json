{
  "name": "Go + Node.js Dev",
  "dockerComposeFile": "docker-compose.devcontainer.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/japan-canvas",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "cd backend && go mod download && cd .. && npm ci",
  "forwardPorts": [3000, 8080, 3306],
  "portsAttributes": {
    "3000": { "label": "Next.js", "onAutoForward": "notify" },
    "8080": { "label": "Go API", "onAutoForward": "notify" },
    "3306": { "label": "MySQL", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "premparihar.gotestexplorer",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-vscode.vscode-typescript-next",
        "usernamehw.errorlens",
        "eamodio.gitlens",
        "streetsidesoftware.code-spell-checker"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[go]": {
          "editor.defaultFormatter": "golang.go"
        },
        "go.useLanguageServer": true,
        "go.formatTool": "gofmt",
        "go.toolsManagement.autoUpdate": true,
        "gopls": {
          "ui.semanticTokens": true
        },
        "eslint.validate": ["javascript", "typescript", "typescriptreact"],
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "remoteUser": "vscode"
}
